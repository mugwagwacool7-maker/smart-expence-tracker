# Copy to .env and fill in. .env is gitignored — never commit real values.
# Every EXPO_PUBLIC_* var is inlined into the app bundle at build time and is
# therefore PUBLIC. Only ship anon/publishable keys here, never service_role.

# --- Supabase (optional) -----------------------------------------------------
# Used by lib/supabase.ts. Not yet wired into any screen: there is no table
# schema or RLS policy in this repo, and all data currently lives in AsyncStorage.
# Project URL and the publishable key are both in Dashboard > Project Settings > API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- AI assistant (optional) -------------------------------------------------
# Base URL of the backend in /server that calls the Claude API, e.g.
# http://192.168.1.20:3000 on a physical device, or http://localhost:3000 on web.
# Leave blank to use the built-in rule-based fallback: the app works fully
# offline and every screen behaves normally without it.
#
# This must NOT be an http:// URL in a production build, or iOS ATS / Android
# cleartext policies will block the request.
EXPO_PUBLIC_AI_URL=

# --- Claude backend (optional, server-side only) -----------------------------
# Read by server/index.js with dotenv. Never expose these with EXPO_PUBLIC_,
# or the key ends up in the shipped bundle where anyone can read it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Run the backend with:  node server/index.js
# Only needed if you want Claude-backed answers. The fallback needs no key.
